'use strict';

const { spawn } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const PLATFORM = os.platform();
const ARCH = os.arch();

const SUPPORTED_PACKAGES = {
  'linux_x64': '@google-cloud/cicd-mcp-linux-amd64',
  'darwin_arm64': '@google-cloud/cicd-mcp-darwin-arm64',
  'win32_x64': '@google-cloud/cicd-mcp-windows-amd64',
};

const subPackage = SUPPORTED_PACKAGES[`${PLATFORM}_${ARCH}`];
if (!subPackage) {
  console.error(`Unsupported platform/architecture: ${PLATFORM}/${ARCH}`);
  process.exit(1);
}

const binaryName = PLATFORM === 'win32' ? 'cicd-mcp-server.exe' : 'cicd-mcp-server';

function resolveBinaryPath() {
  try {
    const pkgJsonPath = require.resolve(`${subPackage}/package.json`);
    return path.join(path.dirname(pkgJsonPath), 'bin', binaryName);
  } catch (_) {
    const hoisted = path.join(__dirname, '..', '..', '..', subPackage, 'bin', binaryName);
    if (fs.existsSync(hoisted)) {
      return hoisted;
    }
    const unscoped = subPackage.replace(/^@[^/]+\//, '');
    return path.join(__dirname, '..', '..', unscoped, 'bin', binaryName);
  }
}

const binPath = resolveBinaryPath();
if (!fs.existsSync(binPath)) {
  console.error(`Binary not found at ${binPath}`);
  process.exit(1);
}

const child = spawn(binPath, process.argv.slice(2), { stdio: 'inherit' });
child.on('exit', (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
  } else {
    process.exit(code ?? 0);
  }
});
